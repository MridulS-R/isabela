<% content_for :title, 'Topics' %>

<section class="py-8">
  <div class="mx-auto max-w-6xl px-4">
    <h1 class="text-2xl font-bold">Topics</h1>
    <ul class="mt-3 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      <% @topics.each do |tp| %>
        <li class="rounded-lg border border-slate-200 dark:border-slate-800 p-3 flex items-center justify-between">
          <span class="text-slate-900 dark:text-slate-100">#<%= tp.name %> <span class="text-slate-500">(@<%= tp.community.slug %>)</span></span>
          <span class="text-slate-500 text-sm"><%= tp.attributes['posts_count'] %></span>
        </li>
      <% end %>
    </ul>
  </div>
</section>

