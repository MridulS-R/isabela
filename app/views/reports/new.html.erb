<% content_for :title, 'Report Content' %>

<section class="py-8">
  <div class="mx-auto max-w-md px-4">
    <h1 class="text-2xl font-bold">Report content</h1>
    <p class="text-slate-600 dark:text-slate-300">Tell us what’s wrong. Our team will review it.</p>

    <%= form_with url: reports_path, method: :post, local: true do %>
      <input type="hidden" name="reportable_type" value="<%= @reportable_type %>">
      <input type="hidden" name="reportable_id" value="<%= @reportable_id %>">
      <div class="mt-3">
        <label class="block text-sm font-medium">Reason</label>
        <input type="text" name="reason" required class="mt-1 w-full px-3 py-2 rounded border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900" placeholder="Spam, harassment, NSFW, ...">
      </div>
      <div class="mt-3">
        <button class="px-3 py-2 rounded-lg bg-slate-900 text-white hover:bg-black dark:bg-slate-800 dark:hover:bg-black">Submit</button>
      </div>
    <% end %>
  </div>
</section>

