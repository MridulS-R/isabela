<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= content_for?(:title) ? yield(:title) : "#CommunNity" %></title>
  <meta name="description" content="#CommunNity is a friendly social platform for groups, creators, and communities to connect, share posts, host events, and build meaningful conversations.">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <%= favicon_link_tag 'favicon.svg' %>
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#111111">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag 'application', media: 'all' %>
  <!-- Tailwind is compiled via tailwindcss-rails (see app/assets/tailwind/application.css) -->
</head>
<body class="antialiased">
  <a class="skip-link" href="#main">Skip to content</a>
  <%= render 'shared/header' %>
  <main id="main" class="min-h-screen">
    <% if notice.present? %>
      <div class="mx-auto max-w-5xl px-4 pt-4" role="status">
        <div class="rounded-lg border border-emerald-200 bg-emerald-50 text-emerald-800 px-4 py-2 text-sm"><%= notice %></div>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="mx-auto max-w-5xl px-4 pt-4" role="alert">
        <div class="rounded-lg border border-rose-200 bg-rose-50 text-rose-800 px-4 py-2 text-sm"><%= alert %></div>
      </div>
    <% end %>
    <%= yield %>
  </main>
  <%= render 'shared/footer' %>
  <%= javascript_include_tag 'application' %>
  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/service-worker.js').catch(() => {});
      });
    }
  </script>
  <noscript>This site works best with JavaScript enabled. All content remains accessible without it.</noscript>
</body>
</html>
