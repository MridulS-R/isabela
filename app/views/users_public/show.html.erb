<% content_for :title, (@user.name.presence || @user.email) %>

<section class="py-8">
  <div class="mx-auto max-w-6xl px-4">
    <header class="flex items-center justify-between mb-4">
      <div>
        <h1 class="text-2xl font-bold"><%= @user.name.presence || @user.email %></h1>
        <p class="text-slate-500">@<%= @user.username.presence || @user.email.to_s.split('@').first %></p>
      </div>
      <% if user_signed_in? && current_user.id != @user.id %>
        <% following = current_user.following.exists?(id: @user.id) rescue false %>
        <% if following %>
          <%= button_to 'Following', unfollow_user_path(@user.id), method: :delete, class: 'px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-sm' %>
        <% else %>
          <%= button_to 'Follow', follow_user_path(@user.id), method: :post, class: 'px-3 py-2 rounded-lg bg-slate-900 text-white hover:bg-black dark:bg-slate-800 dark:hover:bg-black text-sm' %>
        <% end %>
      <% end %>
    </header>

    <% if @user.pinned_post %>
      <div class="mb-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-3">
        <div class="text-xs text-slate-500">Pinned</div>
        <%= link_to truncate(@user.pinned_post.caption.to_s, length: 140), post_path(@user.pinned_post), class: 'text-sky-600 hover:underline' %>
      </div>
    <% end %>

    <nav class="mb-3 flex items-center gap-3 text-sm">
      <%= link_to 'Posts', user_public_path(@user, tab: nil), class: "px-2 py-1 rounded #{params[:tab].blank? ? 'bg-slate-100 dark:bg-slate-800' : ''}" %>
      <%= link_to 'Media', user_public_path(@user, tab: 'media'), class: "px-2 py-1 rounded #{params[:tab] == 'media' ? 'bg-slate-100 dark:bg-slate-800' : ''}" %>
    </nav>

    <% if @posts.any? %>
      <ul class="space-y-3">
        <% @posts.each do |post| %>
          <li class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-3">
            <div class="text-sm text-slate-600 dark:text-slate-300">
              <span class="font-semibold text-slate-900 dark:text-slate-100"><%= @user.name.presence || @user.email %></span>
              <span>· <%= link_to "#{time_ago_in_words(post.created_at)} ago", post_path(post), class: 'text-sky-600 hover:underline' %></span>
            </div>
            <% if post.caption.present? %>
              <p class="mt-1"><%= post.caption %></p>
            <% end %>
            <% if post.images.attached? %>
              <div class="mt-2 grid grid-cols-2 gap-2">
                <% post.images.each do |img| %>
                  <%= image_tag url_for(img), class: 'w-full h-auto rounded' %>
                <% end %>
              </div>
            <% end %>
            <% if user_signed_in? && current_user.id == @user.id %>
              <div class="mt-2 flex items-center gap-2 text-sm">
                <%= link_to 'Edit', edit_post_path(post), class: 'px-2 py-1 rounded border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800' %>
                <%= button_to 'Delete', post_path(post), method: :delete, class: 'px-2 py-1 rounded border border-rose-200 text-rose-700 hover:bg-rose-50', form: { data: { turbo_confirm: 'Delete this post?' } } %>
                <% if current_user.pinned_post_id == post.id %>
                  <%= button_to 'Unpin', unpin_post_path(post), method: :delete, class: 'px-2 py-1 rounded border border-slate-200 dark:border-slate-700' %>
                <% else %>
                  <%= button_to 'Pin', pin_post_path(post), method: :post, class: 'px-2 py-1 rounded border border-slate-200 dark:border-slate-700' %>
                <% end %>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-slate-500">No posts yet.</p>
    <% end %>
  </div>
</section>

