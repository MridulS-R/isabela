<% content_for :title, 'Trending' %>

<section class="py-8">
  <div class="mx-auto max-w-6xl px-4 grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <h1 class="text-2xl font-bold">Trending Tags (last <%= @hours %>h)</h1>
      <ul class="mt-3 space-y-2">
        <% @top_tags.each do |t| %>
          <li class="flex items-center justify-between rounded-lg border border-slate-200 dark:border-slate-800 p-2">
            <%= link_to "##{t.name}", tag_path(t.name), class: 'text-sky-600 hover:underline' %>
            <span class="text-slate-500 text-sm"><%= t.attributes['uses_count'] %></span>
          </li>
        <% end %>
      </ul>
    </div>
    <div>
      <h2 class="text-2xl font-bold">Trending Topics</h2>
      <ul class="mt-3 space-y-2">
        <% @top_topics.each do |tp| %>
          <li class="flex items-center justify-between rounded-lg border border-slate-200 dark:border-slate-800 p-2">
            <span class="text-slate-900 dark:text-slate-100">#<%= tp.name %> <span class="text-slate-500">(@<%= tp.community.slug %>)</span></span>
            <span class="text-slate-500 text-sm"><%= tp.attributes['posts_count'] %></span>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</section>

