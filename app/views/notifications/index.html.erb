<% content_for :title, 'Notifications' %>

<section class="py-8">
  <div class="mx-auto max-w-3xl px-4 surface p-4 sm:p-6">
    <h1 class="text-2xl font-bold mb-4">Notifications</h1>
    <% if @notifications.any? %>
      <ul class="space-y-3">
        <% @notifications.each do |n| %>
          <li class="rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-3 flex items-start justify-between">
            <div>
              <p class="text-sm">
                <span class="font-semibold"><%= n.actor.name.presence || n.actor.email %></span>
                <% if n.action == 'like' %>
                  liked your post
                <% elsif n.action == 'comment' %>
                  commented on your post
                <% elsif n.action == 'repost' %>
                  reposted your post
                <% else %>
                  <%= n.action %>
                <% end %>
              </p>
              <p class="text-xs text-slate-500 mt-1"><%= time_ago_in_words(n.created_at) %> ago</p>
            </div>
            <% if n.read_at.nil? %>
              <%= button_to 'Mark read', read_notification_path(n), method: :post, class: 'text-xs px-2 py-1 rounded border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800' %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-slate-500">No notifications.</p>
    <% end %>
  </div>
</section>
