<% content_for :title, 'Import Reddit Data' %>

<div class="section">
  <div class="container">
    <h1>Import Reddit data</h1>
    <p class="subtle">Upload a CSV/JSON file or paste a public URL. Choose what to import below.</p>

    <%= form_with url: imports_path, method: :post, multipart: true do |f| %>
      <div>
        <%= label_tag :import_kind, 'Import type' %>
        <%= select_tag :import_kind, options_for_select([['Reddit posts','reddit_posts'],['Instagram users','instagram_users'],['News RSS','news_rss']]), include_blank: false %>
      </div>
      <div class="form-row">
        <div>
          <%= label_tag :community_id, 'Community (required for Reddit/News)' %>
          <%= select_tag :community_id, options_from_collection_for_select(Community.order(:name), :id, :name), prompt: 'Select community' %>
        </div>
        <div>
          <%= label_tag :url, 'Data URL (CSV or JSON)' %>
          <%= url_field_tag :url, nil, placeholder: 'https://.../reddit.csv' %>
        </div>
        <div>
          <%= label_tag :owner_email, 'Owner email (for Reddit posts)' %>
          <%= email_field_tag :owner_email, nil, placeholder: 'owner@example.com' %>
        </div>
      </div>
      <p class="subtle">— or —</p>
      <div>
        <%= label_tag :data_file, 'Upload CSV/JSON' %>
        <%= file_field_tag :data_file, accept: '.csv,.json' %>
      </div>
      <p class="help">Provide a URL or upload a file (one is required). Owner email applies only to Reddit post imports.</p>
      <%= submit_tag 'Start Import', class: 'btn' %>
    <% end %>
  </div>
  </div>
