<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <%= link_to raw('<span class="logo" aria-hidden="true">▦</span> #community'), root_path, class: 'brand' %>
      <p class="subtle">A friendly place to connect.</p>
      <p class="subtle">© <span id="year"></span> #community. All rights reserved.</p>
    </div>
    <div>
      <h3 class="footer-title">Company</h3>
      <ul>
        <li><%= link_to 'About', about_path %></li>
        <li><%= link_to 'Updates', blog_path %></li>
        <li><%= link_to 'Contact', contact_path %></li>
      </ul>
    </div>
    <div>
      <h3 class="footer-title">Solutions</h3>
      <ul>
        <li><%= link_to 'Groups', solutions_path(anchor: 'groups') %></li>
        <li><%= link_to 'Events', solutions_path(anchor: 'events') %></li>
        <li><%= link_to 'Creators', solutions_path(anchor: 'creators') %></li>
      </ul>
    </div>
    <div>
      <h3 class="footer-title">Legal</h3>
      <ul>
        <li><a href="#" aria-disabled="true">Privacy Policy</a></li>
        <li><a href="#" aria-disabled="true">Terms</a></li>
        <li><a href="#" aria-disabled="true">GDPR & India IT Act</a></li>
      </ul>
    </div>
  </div>
</footer>
