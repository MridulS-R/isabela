<%# Locals: article:, variant: :default | :lead | :secondary %>
<% variant ||= :default %>
<article class="headline-card">
  <% if article.first_image_url.present? %>
    <%= image_tag article.first_image_url, alt: '', class: (variant == :lead ? 'headline-image' : 'headline-image'), loading: 'lazy' %>
  <% end %>
  <<%= (variant == :lead ? 'h2' : 'h3') %>>
    <% if article.respond_to?(:url) && article.url.present? %>
      <%= link_to article.title, article.url, class: 'link clamp-2', target: '_blank', rel: 'noopener' %>
    <% else %>
      <span class="clamp-2"><%= article.title %></span>
    <% end %>
  </<%= (variant == :lead ? 'h2' : 'h3') %>>
  <p class="story-meta">
    <%= article.published_at&.strftime('%b %d, %Y') %>
    <% if article.respond_to?(:source) && article.source.present? %>
      • <%= link_to article.source, blog_path(source: article.source), class: 'link' %>
    <% end %>
  </p>
  <% if article.body.present? %>
    <p class="clamp-3"><%= truncate(strip_tags(article.body.to_s), length: 180) %></p>
  <% end %>
</article>

