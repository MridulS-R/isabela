<header class="site-header">
  <div class="container header-inner">
    <%= link_to raw('<span class="logo" aria-hidden="true">▦</span> #community'), root_path, class: 'brand' %>
    <button class="nav-toggle" aria-controls="primary-nav" aria-expanded="false">Menu</button>
    <nav id="primary-nav" class="site-nav" aria-label="Primary">
      <ul>
        <li><%= link_to 'Home', root_path, aria: { current: current_page?(root_path) ? 'page' : nil } %></li>
        <li><%= link_to 'Hots', posts_path(sort: 'hot'), aria: { current: (current_page?(posts_path(sort: 'hot'))) ? 'page' : nil } %></li>
        <li><%= link_to 'News', blog_path, aria: { current: current_page?(blog_path) ? 'page' : nil } %></li>
        <% if user_signed_in? %>
          <li><%= link_to 'New Post', new_post_path, class: 'btn btn-small' %></li>
          <li><span class="subtle">Hi, <%= current_user.name.presence || current_user.email %></span></li>
          <li>
            <%= button_to 'Log out', logout_path, method: :delete, class: 'btn btn-small', form: { style: 'display:inline' } %>
          </li>
        <% else %>
          <li><%= link_to 'Login', login_path %></li>
          <li><%= link_to 'Signup', signup_path, class: 'btn btn-small' %></li>
        <% end %>
      </ul>
    </nav>
  </div>
</header>
