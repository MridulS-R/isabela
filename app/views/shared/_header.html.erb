<header class="sticky top-0 z-50 header-bar border-transparent brand-shadow">
  <div class="mx-auto max-w-6xl px-4">
    <div class="flex h-16 items-center justify-between">
      <%= link_to raw('<span class="inline-block w-6 h-6 mr-2" aria-hidden="true">▦</span> <span class="font-bold">#CommunNity</span>'), root_path, class: 'text-white no-underline hover:opacity-90 text-base' %>
      <nav id="primary-nav" class="hidden md:flex items-center gap-3" aria-label="Primary">
        <ul class="flex items-center gap-3 m-0 p-0">
          <li><%= link_to 'Home', root_path, class: "px-3 py-2 rounded-lg nav-link #{current_page?(root_path) ? 'nav-active' : ''}" %></li>
          <li><%= link_to 'Feed', home_path, class: "px-3 py-2 rounded-lg nav-link #{current_page?(home_path) ? 'nav-active' : ''}" %></li>
          <li><%= link_to 'Posts', posts_path, class: "px-3 py-2 rounded-lg nav-link #{current_page?(posts_path) ? 'nav-active' : ''}" %></li>
          
          <% if user_signed_in? %>
            
            <li>
              <%= link_to (current_user.name.presence || current_user.email), profile_path, class: 'px-3 py-2 rounded-lg text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white' %>
            </li>
            <li>
              <%= link_to notifications_path, id: 'notif-link', class: 'relative px-3 py-2 rounded-lg nav-link', aria: { label: 'Notifications' } do %>
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 8a6 6 0 10-12 0c0 7-3 9-3 9h18s-3-2-3-9"/>
                  <path d="M13.73 21a2 2 0 01-3.46 0"/>
                </svg>
                <% if unread_notifications_count.to_i > 0 %>
                  <span id="notif-badge" class="absolute -top-1 -right-1 inline-flex items-center justify-center min-w-[18px] h-[18px] text-[11px] px-1 rounded-full badge-brand"><%= unread_notifications_count %></span>
                <% else %>
                  <span id="notif-badge" class="hidden absolute -top-1 -right-1 inline-flex items-center justify-center min-w-[18px] h-[18px] text-[11px] px-1 rounded-full badge-brand">0</span>
                <% end %>
              <% end %>
            </li>
            <li>
              <%= button_to 'Log out', logout_path, method: :delete, class: 'btn', form: { class: 'inline' } %>
            </li>
          <% else %>
            <li><%= link_to 'Login', login_path, class: 'px-3 py-2 rounded-lg nav-link' %></li>
            <li><%= link_to 'Signup', signup_path, class: 'btn btn-brand' %></li>
          <% end %>
        </ul>
        <button id="theme-toggle" class="ml-1 inline-flex items-center justify-center w-9 h-9 rounded-full border border-slate-300 text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800" aria-label="Toggle dark mode">☾</button>
      </nav>
    </div>
  </div>
</header>
