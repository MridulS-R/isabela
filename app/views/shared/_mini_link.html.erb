<%# Locals: article: %>
<li class="mini-item">
  <div>
    <strong>
      <% if article.respond_to?(:url) && article.url.present? %>
        <%= link_to truncate(article.title.to_s, length: 80), article.url, class: 'link clamp-2', target: '_blank', rel: 'noopener' %>
      <% else %>
        <span class="clamp-2"><%= truncate(article.title.to_s, length: 80) %></span>
      <% end %>
    </strong>
    <div class="story-meta"><%= article.published_at&.strftime('%b %d, %Y') %><% if article.respond_to?(:source) && article.source.present? %> • <%= link_to article.source, blog_path(source: article.source), class: 'link' %><% end %></div>
  </div>
</li>

