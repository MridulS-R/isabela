<% content_for :title, 'Reports' %>

<section class="py-8">
  <div class="mx-auto max-w-6xl px-4">
    <h1 class="text-2xl font-bold">Reports</h1>
    <div class="overflow-x-auto mt-3 rounded-lg border border-slate-200 dark:border-slate-800">
      <table class="min-w-full text-sm">
        <thead class="bg-slate-50 dark:bg-slate-900/50 text-slate-600 dark:text-slate-300">
          <tr><th class="p-2 text-left">ID</th><th class="p-2 text-left">Status</th><th class="p-2 text-left">Reason</th><th class="p-2 text-left">Type</th><th class="p-2 text-left">Target</th><th class="p-2 text-left">Reporter</th><th class="p-2 text-left">Created</th><th class="p-2"></th></tr>
        </thead>
        <tbody>
          <% @reports.each do |r| %>
            <tr class="border-t border-slate-200 dark:border-slate-800">
              <td class="p-2"><%= r.id %></td>
              <td class="p-2"><%= r.status %></td>
              <td class="p-2"><%= r.reason %></td>
              <td class="p-2"><%= r.reportable_type %></td>
              <td class="p-2"><%= r.reportable_id %></td>
              <td class="p-2"><%= r.user.email %></td>
              <td class="p-2"><%= r.created_at.strftime('%Y-%m-%d %H:%M') %></td>
              <td class="p-2"><%= link_to 'Open', admin_report_path(r), class: 'px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 text-sm' %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</section>

