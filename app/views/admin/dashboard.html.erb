<% content_for :title, 'Admin Dashboard' %>

<section class="py-8">
  <div class="mx-auto max-w-6xl px-4 surface p-4 sm:p-6">
    <h1 class="text-2xl font-bold">Admin Dashboard</h1>
    <p class="text-slate-600">Overview of community activity and content.</p>
    <div class="brand-divider my-3"></div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mt-3">
      <article class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-3 text-center"><h3 class="text-sm font-semibold">Users</h3><p class="text-2xl font-bold"><%= @counts[:users] %></p></article>
      <article class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-3 text-center"><h3 class="text-sm font-semibold">Posts</h3><p class="text-2xl font-bold"><%= @counts[:posts] %></p></article>
      <article class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-3 text-center"><h3 class="text-sm font-semibold">Likes</h3><p class="text-2xl font-bold"><%= @counts[:likes] %></p></article>
      <article class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-3 text-center"><h3 class="text-sm font-semibold">Comments</h3><p class="text-2xl font-bold"><%= @counts[:comments] %></p></article>
      <article class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-3 text-center"><h3 class="text-sm font-semibold">Tags</h3><p class="text-2xl font-bold"><%= @counts[:tags] %></p></article>
      <article class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-3 text-center"><h3 class="text-sm font-semibold">Follows</h3><p class="text-2xl font-bold"><%= @counts[:follows] %></p></article>
    </div>
  </div>
</section>

<section class="py-8">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="text-xl font-semibold">Posts per day (last 14)</h2>
    <div class="overflow-x-auto mt-2 rounded-lg border border-slate-200 dark:border-slate-800">
      <table class="min-w-full text-sm">
        <thead class="bg-slate-50 dark:bg-slate-900/50 text-slate-600 dark:text-slate-300"><tr><th class="text-left p-2">Date</th><th class="text-left p-2">Posts</th></tr></thead>
        <tbody>
          <% @series_posts_per_day.each do |d, n| %>
            <tr class="border-t border-slate-200 dark:border-slate-800"><td class="p-2"><%= d.strftime('%Y-%m-%d') %></td><td class="p-2"><%= n %></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="py-8">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="text-xl font-semibold">Promoted posts performance</h2>
    <div class="overflow-x-auto mt-2 rounded-lg border border-slate-200 dark:border-slate-800">
      <table class="min-w-full text-sm">
        <thead class="bg-slate-50 dark:bg-slate-900/50 text-slate-600 dark:text-slate-300"><tr><th class="text-left p-2">Post</th><th class="text-left p-2">Impressions</th><th class="text-left p-2">Clicks</th><th class="text-left p-2">CTR</th></tr></thead>
        <tbody>
          <% PromotedPost.order(clicks_count: :desc, impressions_count: :desc).limit(10).each do |r| %>
            <tr class="border-t border-slate-200 dark:border-slate-800">
              <td class="p-2"><%= link_to "Post ##{r.post_id}", post_path(r.post_id), class: 'text-sky-600 hover:underline' %></td>
              <td class="p-2"><%= r.impressions_count %></td>
              <td class="p-2"><%= r.clicks_count %></td>
              <td class="p-2"><%= (r.impressions_count > 0) ? ((r.clicks_count.to_f / r.impressions_count) * 100).round(1) : 0 %>%</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="py-8">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="text-xl font-semibold">Top tags</h2>
    <div class="overflow-x-auto mt-2 rounded-lg border border-slate-200 dark:border-slate-800">
      <table class="min-w-full text-sm">
        <thead class="bg-slate-50 dark:bg-slate-900/50 text-slate-600 dark:text-slate-300"><tr><th class="text-left p-2">Tag</th><th class="text-left p-2">Posts</th></tr></thead>
        <tbody>
          <% @top_tags.each do |t| %>
            <tr class="border-t border-slate-200 dark:border-slate-800"><td class="p-2">#<%= t.name %></td><td class="p-2"><%= t.taggings.count %></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="py-8">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="text-xl font-semibold">Top users by posts</h2>
    <div class="overflow-x-auto mt-2 rounded-lg border border-slate-200 dark:border-slate-800">
      <table class="min-w-full text-sm">
        <thead class="bg-slate-50 dark:bg-slate-900/50 text-slate-600 dark:text-slate-300"><tr><th class="text-left p-2">User</th><th class="text-left p-2">Posts</th></tr></thead>
        <tbody>
          <% @top_users_by_posts.each do |u| %>
            <tr class="border-t border-slate-200 dark:border-slate-800"><td class="p-2"><%= u.name.presence || u.email %></td><td class="p-2"><%= u.posts.size %></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="py-8">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="text-xl font-semibold">Top posts</h2>
    <div class="overflow-x-auto mt-2 rounded-lg border border-slate-200 dark:border-slate-800">
      <table class="min-w-full text-sm">
        <thead class="bg-slate-50 dark:bg-slate-900/50 text-slate-600 dark:text-slate-300"><tr><th class="text-left p-2">Caption</th><th class="text-left p-2">Likes</th><th class="text-left p-2">Created</th></tr></thead>
        <tbody>
          <% @top_posts.each do |p| %>
            <tr class="border-t border-slate-200 dark:border-slate-800"><td class="p-2"><%= truncate(p.caption.to_s, length: 80) %></td><td class="p-2"><%= p.likes_count %></td><td class="p-2"><%= p.created_at.strftime('%Y-%m-%d') %></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</section>
