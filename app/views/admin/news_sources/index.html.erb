<% content_for :title, 'News Sources' %>

<section class="py-8">
  <div class="mx-auto max-w-6xl px-4">
    <h1 class="text-2xl font-bold">News Sources</h1>
    <p class="text-slate-600 dark:text-slate-300">Manage predefined sites to crawl for community news.</p>

    <%= form_with model: @source, url: admin_news_sources_path, method: :post do |f| %>
      <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 mt-3">
        <div>
          <%= f.label :name, class: 'block text-sm font-medium' %>
          <%= f.text_field :name, required: true, class: 'mt-1 w-full px-3 py-2 rounded border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900' %>
        </div>
        <div>
          <%= f.label :community_id, 'Community', class: 'block text-sm font-medium' %>
          <%= f.collection_select :community_id, Community.order(:name), :id, :name, { prompt: 'Select community' }, { required: true, class: 'mt-1 w-full px-3 py-2 rounded border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900' } %>
        </div>
        <div>
          <%= f.label :kind, class: 'block text-sm font-medium' %>
          <%= f.select :kind, NewsSource.kinds.keys.map { |k| [k, k] }, {}, { required: true, class: 'mt-1 w-full px-3 py-2 rounded border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900' } %>
        </div>
        <div>
          <%= f.label :active, class: 'block text-sm font-medium' %>
          <%= f.check_box :active, checked: true, class: 'mt-2' %>
        </div>
      </div>
      <div class="mt-3">
        <%= f.label :list_urls, 'List URLs (one per line)', class: 'block text-sm font-medium' %>
        <%= f.text_area :list_urls, rows: 3, placeholder: "https://example.com/news\nhttps://example.com/tech", class: 'mt-1 w-full px-3 py-2 rounded border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900' %>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-3">
        <div>
          <%= f.label :link_selector, class: 'block text-sm font-medium' %>
          <%= f.text_field :link_selector, placeholder: 'e.g., article h2 a', class: 'mt-1 w-full px-3 py-2 rounded border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900' %>
        </div>
        <div>
          <%= f.label :body_selector, class: 'block text-sm font-medium' %>
          <%= f.text_field :body_selector, placeholder: 'e.g., article .content', class: 'mt-1 w-full px-3 py-2 rounded border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900' %>
        </div>
        <div>
          <%= f.label :date_selector, class: 'block text-sm font-medium' %>
          <%= f.text_field :date_selector, placeholder: "e.g., meta[property='article:published_time']", class: 'mt-1 w-full px-3 py-2 rounded border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900' %>
        </div>
      </div>
      <%= f.submit 'Add source', class: 'mt-3 px-3 py-2 rounded-lg bg-slate-900 text-white hover:bg-black dark:bg-slate-800 dark:hover:bg-black' %>
    <% end %>
  </div>
</section>

<section class="py-8">
  <div class="mx-auto max-w-6xl px-4">
    <div class="flex items-center justify-between">
      <h2 class="text-xl font-semibold">Existing sources</h2>
      <%= button_to 'Crawl all', admin_news_sources_path.merge(action: nil), method: :post, form: { action: admin_news_sources_path }, class: 'px-3 py-2 rounded-lg bg-slate-900 text-white hover:bg-black dark:bg-slate-800 dark:hover:bg-black text-sm', formmethod: 'post', formaction: admin_news_sources_path %>
    </div>
    <div class="overflow-x-auto mt-2 rounded-lg border border-slate-200 dark:border-slate-800">
    <table class="min-w-full text-sm">
      <thead>
        <tr class="bg-slate-50 dark:bg-slate-900/50 text-slate-600 dark:text-slate-300"><th class="text-left p-2">Name</th><th class="text-left p-2">Community</th><th class="text-left p-2">Kind</th><th class="text-left p-2">Active</th><th class="text-left p-2">Last crawled</th><th class="text-left p-2">Error</th><th class="p-2"></th></tr>
      </thead>
      <tbody>
        <% @sources.each do |s| %>
          <tr class="border-t border-slate-200 dark:border-slate-800">
            <td class="p-2"><%= s.name %></td>
            <td class="p-2"><%= s.community.name %></td>
            <td class="p-2"><%= s.kind %></td>
            <td class="p-2"><%= s.active ? 'Yes' : 'No' %></td>
            <td class="p-2"><%= s.last_crawled_at&.strftime('%Y-%m-%d %H:%M') || '—' %></td>
            <td class="p-2 text-slate-500"><%= truncate(s.last_error.to_s, length: 60) %></td>
            <td class="p-2">
              <%= button_to 'Crawl', crawl_admin_news_source_path(s), method: :post, class: 'px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-sm' %>
              <%= link_to 'Edit', edit_admin_news_source_path(s), class: 'px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-sm' %>
              <%= button_to 'Remove', admin_news_source_path(s), method: :delete, class: 'px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-sm', form: { data: { turbo_confirm: 'Remove source?' } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  </div>
</section>
