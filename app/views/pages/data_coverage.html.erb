<% content_for :title, 'Data Coverage & Capabilities — VisionData' %>

<section class="section">
  <div class="container">
    <h1>Data Coverage & Capabilities</h1>
    <p class="lead">Breadth and depth you can measure — with quality processes that keep data fresh, accurate, and activation‑ready.</p>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <h2>Coverage at a glance</h2>
    <div class="metrics-grid">
      <div class="metric"><div class="num">50M+</div><div class="label">Business profiles</div></div>
      <div class="metric"><div class="num">200M+</div><div class="label">Consumer profiles</div></div>
      <div class="metric"><div class="num">400+</div><div class="label">Attributes per record</div></div>
      <div class="metric"><div class="num">90%+</div><div class="label">Email deliverability targets</div></div>
      <div class="metric"><div class="num">30 days</div><div class="label">Avg. refresh cadence</div></div>
      <div class="metric"><div class="num">99.9%</div><div class="label">API uptime objective</div></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2>Quality & Freshness</h2>
    <ul class="pill-list" role="list">
      <li>Multi-source compilation and normalization</li>
      <li>Deterministic + probabilistic identity resolution</li>
      <li>Ongoing verification and bounce monitoring</li>
      <li>Change detection and recency scoring</li>
      <li>Human-in-the-loop QA for critical fields</li>
      <li>Regional compliance and consent workflows</li>
    </ul>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <h2>Blended Identity & Persona Modeling</h2>
    <p>We connect business and consumer identities to enable complete views of decision makers and buying committees. Our approach blends deterministic keys (domain, phone, government identifiers where permitted) with probabilistic signals (co‑occurrence, behavioral, and location) to maximize match accuracy while minimizing false links.</p>
    <table>
      <thead>
        <tr><th>Layer</th><th>Examples</th><th>Purpose</th></tr>
      </thead>
      <tbody>
        <tr><td>Deterministic</td><td>Domain, email, phone, firm ID</td><td>High‑confidence entity linking</td></tr>
        <tr><td>Probabilistic</td><td>Location, device, co‑visit patterns</td><td>Expand coverage with conservative thresholds</td></tr>
        <tr><td>Human QA</td><td>Manual validation on edge cases</td><td>Reduce false positives</td></tr>
      </tbody>
    </table>
  </div>
</section>

<section class="section">
  <div class="container cta-band-inner">
    <h2>Request a data dictionary</h2>
    <p>Get a complete attribute list with definitions, types, and refresh cadence by source.</p>
    <%= link_to 'Request Now', contact_path(anchor: 'request-demo'), class: 'btn' %>
  </div>
</section>

