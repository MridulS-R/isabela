<% content_for :title, 'Platform & Capabilities — #CommuniNity' %>

<section class="section">
  <div class="container">
    <h1>Platform & Capabilities</h1>
    <p class="lead">Fast, safe, and privacy‑first — the foundation for welcoming communities at scale.</p>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <h2>At a glance</h2>
    <div class="metrics-grid">
      <div class="metric"><div class="num">99.9%</div><div class="label">Uptime objective</div></div>
      <div class="metric"><div class="num">&lt; 200ms</div><div class="label">Median read latency</div></div>
      <div class="metric"><div class="num">SLA</div><div class="label">Priority moderation</div></div>
      <div class="metric"><div class="num">GDPR</div><div class="label">Privacy by default</div></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2>Safety & Privacy</h2>
    <ul class="pill-list" role="list">
      <li>Anti‑abuse protections and reporting</li>
      <li>Role‑based moderation and guidelines</li>
      <li>Content controls (visibility, mentions, reactions)</li>
      <li>Data export tools for owners</li>
      <li>GDPR/IT‑Act aligned processes</li>
    </ul>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <h2>Architecture & Moderation Layers</h2>
    <p>#CommuniNity separates content, membership, and moderation concerns to keep experiences fast and safe. Async pipelines evaluate signals and elevate reports for human review where appropriate.</p>
    <table>
      <thead>
        <tr><th>Layer</th><th>Examples</th><th>Purpose</th></tr>
      </thead>
      <tbody>
        <tr><td>Realtime</td><td>Rate limits, flood control</td><td>Prevent spam and abuse</td></tr>
        <tr><td>Batch</td><td>Signals, velocity checks</td><td>Detect coordinated behavior</td></tr>
        <tr><td>Human</td><td>Escalation & appeals</td><td>Fair outcomes on edge cases</td></tr>
      </tbody>
    </table>
  </div>
</section>

<section class="section">
  <div class="container cta-band-inner">
    <h2>Request platform access</h2>
    <p>Tell us about your community and we’ll help you get started.</p>
    <%= link_to 'Get Early Access', contact_path(anchor: 'request-demo'), class: 'btn' %>
  </div>
</section>
