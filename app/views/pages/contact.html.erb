<% content_for :title, 'Contact #CommunNity' %>

<section class="section">
  <div class="container">
    <h1>Get early access</h1>
    <p class="lead">Tell us about your community and we’ll reach out with next steps.</p>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <div class="form-row">
      <div>
        <h2 id="request-demo">Request Access</h2>
        <form data-enhanced="contact" aria-describedby="form-status">
          <div class="form-row">
            <div>
              <label for="name">Name</label>
              <input id="name" name="name" type="text" placeholder="Your name" required>
            </div>
            <div>
              <label for="email">Email</label>
              <input id="email" name="email" type="email" placeholder="you@company.com" required>
            </div>
          </div>
          <div class="form-row">
            <div>
              <label for="company">Company</label>
              <input id="company" name="company" type="text" placeholder="Company name">
            </div>
            <div>
                  <label for="reason">I’m a</label>
                  <select id="reason" name="reason">
                    <option>Creator</option>
                    <option>Organization</option>
                    <option>Developer</option>
                    <option>Moderator</option>
                  </select>
            </div>
          </div>
          <div>
            <label for="message">Message</label>
            <textarea id="message" name="message" placeholder="Tell us a bit about your use case"></textarea>
          </div>
          <p id="form-status" class="help" hidden>We’ll reply shortly.</p>
          <button class="btn" type="submit">Send</button>
        </form>
      </div>
      <div>
        <h2 id="talk-to-expert">Talk to the team</h2>
        <p class="subtle">Prefer email or phone?</p>
        <p><strong>Email:</strong> hello@community.example</p>
        <p><strong>Phone:</strong> +1 (555) 010‑1234</p>
        <p><strong>Office:</strong> Remote‑first</p>
      </div>
    </div>
  </div>
</section>
