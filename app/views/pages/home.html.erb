<% content_for :title, 'VisionData — Turning raw data into actionable insights' %>

<section class="hero">
  <div class="container hero-inner">
    <h1>Turning raw data into actionable insights</h1>
    <p class="lead">Accurate business and consumer data, powerful enrichment, and analytics that drive growth across channels.</p>
    <div class="cta-group">
      <%= link_to 'Request a Demo', contact_path(anchor: 'request-demo'), class: 'btn' %>
      <%= link_to 'Talk to a Data Expert', contact_path(anchor: 'talk-to-expert'), class: 'btn btn-outline' %>
      <%= link_to 'Get Started', solutions_path, class: 'btn btn-ghost' %>
    </div>
  </div>
  <div class="hero-visual" aria-hidden="true">
    <svg viewBox="0 0 600 200" preserveAspectRatio="none" role="img" aria-label="" focusable="false">
      <defs>
        <linearGradient id="g" x1="0" x2="1" y1="0" y2="1">
          <stop offset="0%" stop-color="var(--brand)"/>
          <stop offset="100%" stop-color="var(--brand-700)"/>
        </linearGradient>
      </defs>
      <rect x="0" y="0" width="600" height="200" fill="url(#g)" opacity="0.08"/>
      <g fill="none" stroke="var(--brand)" opacity="0.5">
        <path d="M0 150 C 150 120, 300 180, 600 130"/>
        <path d="M0 120 C 180 90, 340 140, 600 100" opacity="0.5"/>
        <path d="M0 90 C 120 60, 360 120, 600 70" opacity="0.25"/>
      </g>
    </svg>
  </div>
</section>

<section class="value-prop section">
  <div class="container">
    <h2>Data that’s fresh, accurate, and ready to activate</h2>
    <p>VisionData delivers comprehensive business and consumer coverage, robust enrichment and cleansing, and the tools to segment, analyze, and engage audiences across email, direct mail, and digital channels.</p>
    <ul class="pill-list" role="list">
      <li>Comprehensive business & consumer data</li>
      <li>Data enrichment & cleansing</li>
      <li>Audience segmentation & analytics</li>
      <li>Lead generation & acquisition</li>
      <li>Omnichannel marketing support</li>
      <li>APIs & integrations</li>
      <li>Compliance & privacy</li>
      <li>Custom solutions & consulting</li>
    </ul>
  </div>
</section>

<section class="features section alt">
  <div class="container">
    <h2>Solutions built for performance</h2>
    <div class="cards-grid">
      <article class="card">
        <div class="icon" aria-hidden="true">📇</div>
        <h3>Data Solutions</h3>
        <p>Fresh, accurate business and consumer records with rich attributes, plus data hygiene, dedupe, and identity resolution.</p>
        <%= link_to 'Explore Data Solutions', solutions_path(anchor: 'data-solutions'), class: 'link' %>
      </article>
      <article class="card">
        <div class="icon" aria-hidden="true">📈</div>
        <h3>Marketing Solutions</h3>
        <p>Audience building, targeted acquisition, and campaign execution across email, direct mail, and digital.</p>
        <%= link_to 'Explore Marketing Solutions', solutions_path(anchor: 'marketing-solutions'), class: 'link' %>
      </article>
      <article class="card">
        <div class="icon" aria-hidden="true">🔌</div>
        <h3>APIs & Integrations</h3>
        <p>Programmatic access to data and enrichment with integrations for popular CRMs and marketing platforms.</p>
        <%= link_to 'Explore APIs', solutions_path(anchor: 'apis'), class: 'link' %>
      </article>
    </div>
  </div>
</section>

<section class="metrics section">
  <div class="container">
    <h2>Coverage and quality at scale</h2>
    <div class="metrics-grid">
      <div class="metric"><div class="num">50M+</div><div class="label">Business profiles</div></div>
      <div class="metric"><div class="num">200M+</div><div class="label">Consumer profiles</div></div>
      <div class="metric"><div class="num">400+</div><div class="label">Attributes per record</div></div>
      <div class="metric"><div class="num">30 days</div><div class="label">Average refresh cadence</div></div>
    </div>
    <p class="subtle">Figures represent typical coverage; availability varies by region and source.</p>
  </div>
</section>

<section class="trust section alt">
  <div class="container">
    <h2>Trusted by data‑driven teams</h2>
    <div class="logo-row" aria-hidden="true">
      <div class="logo-pill">Acme SaaS</div>
      <div class="logo-pill">Northwind</div>
      <div class="logo-pill">BlueCart</div>
      <div class="logo-pill">Contoso</div>
      <div class="logo-pill">Globex</div>
    </div>
    <div class="quote">
      <blockquote>
        “VisionData has elevated our demand generation with cleaner data and smarter targeting. Our cost per qualified lead dropped 27% in the first quarter.”
      </blockquote>
      <p class="cite">— Priya S., VP Growth, Acme SaaS</p>
    </div>
  </div>
</section>

<section class="cta-band section">
  <div class="container cta-band-inner">
    <h2>See VisionData in action</h2>
    <p>Book a live demo to explore data coverage, enrichment, and integrations tailored to your stack.</p>
    <%= link_to 'Schedule a Demo', contact_path(anchor: 'request-demo'), class: 'btn' %>
  </div>
</section>

