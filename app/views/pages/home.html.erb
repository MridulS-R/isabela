<% content_for :title, '#community — Front Page' %>

<section class="section">
  <div class="container">
    <header class="masthead">
      <div class="brand-banner">COMMUNNITY</div>
      <div class="strap">Front Page — The latest from communities you care about</div>
      <div class="dateline">
        <span><%= Time.current.strftime('%A, %B %e, %Y') %></span>
        <span>Edition: Online</span>
      </div>
    </header>

    <div class="newspaper-grid">
      <% if @news_top.present? %>
        <% lead = @news_top.first %>
        <article class="story lead">
          <% if lead.first_image_url.present? %>
            <%= image_tag lead.first_image_url, alt: '', loading: 'lazy' %>
          <% end %>
          <div class="kicker">Top Story</div>
          <h2 class="headline lead">
            <% if lead.url.present? %>
              <%= link_to lead.title, lead.url, class: 'link', target: '_blank', rel: 'noopener' %>
            <% else %>
              <%= lead.title %>
            <% end %>
          </h2>
          <div class="subhed"><%= truncate(strip_tags(lead.body.to_s), length: 180) %></div>
          <div class="byline"><%= lead.published_at&.strftime('%b %d, %Y') %><% if lead.source.present? %> • <%= lead.source %><% end %></div>
        </article>
      <% end %>

      <% @news_secondary.each do |a| %>
        <article class="story">
          <div class="kicker">News</div>
          <h3 class="headline">
            <% if a.url.present? %>
              <%= link_to a.title, a.url, class: 'link', target: '_blank', rel: 'noopener' %>
            <% else %>
              <%= a.title %>
            <% end %>
          </h3>
          <div class="subhed"><%= truncate(strip_tags(a.body.to_s), length: 120) %></div>
          <div class="byline"><%= a.published_at&.strftime('%b %d, %Y') %><% if a.source.present? %> • <%= a.source %><% end %></div>
        </article>
      <% end %>

      <% @news_latest.first(9).each do |a| %>
        <article class="story">
          <h4 class="headline"><%= link_to truncate(a.title.to_s, length: 100), (a.url.presence || '#'), class: 'link', target: (a.url.present? ? '_blank' : nil), rel: 'noopener' %></h4>
          <p class="byline"><%= a.published_at&.strftime('%b %d') %><% if a.source.present? %> • <%= a.source %><% end %></p>
        </article>
      <% end %>
    </div>
  </div>
</section>
