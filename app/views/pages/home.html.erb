<% content_for :title, '#community — Top stories' %>

<section class="section">
  <div class="container">
    <div class="news-grid">
      <div>
        <div class="brand-tag">#Community</div>
        <h1 class="hero-title">#community</h1>
        <p class="hero-subtitle">A friendly platform where groups and creators share posts, follow topics, and stay informed — built for healthy, modern communities.</p>
        <h2 style="margin-top:8px">Top stories</h2>
        <div class="news-top">
          <% if @news_top.present? %>
            <%= render 'shared/news_card', article: @news_top.first, variant: :lead %>
          <% end %>
          <% @news_secondary.each do |a| %>
            <%= render 'shared/news_card', article: a, variant: :secondary %>
          <% end %>
        </div>

        
      </div>

      <aside>
        <h2 style="margin-top:0">Latest</h2>
        <ul class="mini-list">
          <% @news_latest.each do |a| %>
            <%= render 'shared/mini_link', article: a %>
          <% end %>
        </ul>
        <div style="margin-top:12px">
          <%= link_to 'See all news', blog_path, class: 'link' %>
        </div>

        <h3 style="margin-top:16px">Topics</h3>
        <div class="topic-chips">
          <% @trending_tags.each do |t| %>
            <% count = (t.try(:posts_count) || t.try(:read_attribute, 'posts_count') || 0) %>
            <%= link_to "##{t.name} (#{count})", tag_path(t.name), class: 'chip' %>
          <% end %>
        </div>
      </aside>
    </div>
  </div>
</section>
