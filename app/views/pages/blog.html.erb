<% content_for :title, 'Updates — #community' %>

<section class="section">
  <div class="container">
    <h1>News</h1>
    <% if defined?(@current_source) && @current_source.present? %>
      <p class="subtle">Breadcrumbs: <%= link_to 'News', blog_path, class: 'link' %> › <%= @current_source %></p>
    <% else %>
      <p class="lead">Top stories from across sources.</p>
    <% end %>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <% if @articles.present? %>
      <div class="cards-grid">
        <% @articles.each do |post| %>
          <%= render 'shared/news_card', article: post, variant: :secondary %>
        <% end %>
      </div>
    <% else %>
      <div class="cards-grid">
        <article class="card">
          <h3>Guide: Building High‑Quality B2B Audiences</h3>
          <p>How to translate ICPs into precise filters, avoid common pitfalls, and validate performance early.</p>
          <a class="link" href="#" aria-disabled="true">Read guide</a>
        </article>
        <article class="card">
          <h3>Case Study: 27% Lower CPL with Enrichment</h3>
          <p>See how better data and scoring improved routing and conversion for a SaaS sales team.</p>
          <a class="link" href="#" aria-disabled="true">Read case study</a>
        </article>
        <article class="card">
          <h3>Checklist: Data Hygiene for Campaigns</h3>
          <p>Practical steps to improve deliverability and match rates before activation.</p>
          <a class="link" href="#" aria-disabled="true">Download checklist</a>
        </article>
      </div>
    <% end %>
  </div>
</section>
