<% content_for :title, 'Features — #community' %>

<section class="section">
  <div class="container">
    <h1>Features</h1>
    <p class="lead">Everything you need to build and grow healthy communities.</p>
  </div>
  </section>

<section id="groups" class="section alt">
  <div class="container">
    <h2>Groups & Threads</h2>
    <div class="cards-grid">
      <article class="card">
        <h3>Public & Private Spaces</h3>
        <p>Create open communities or invite‑only groups. Organize discussions into threads to keep topics focused.</p>
      </article>
      <article class="card">
        <h3>Rich Posts</h3>
        <p>Share text, links, and media. Mention people, react with emojis, and pin important updates.</p>
      </article>
      <article class="card">
        <h3>Safety & Moderation</h3>
        <p>Flag/report content, member roles, and community guidelines built‑in. Tools to keep spaces welcoming.</p>
      </article>
      <article class="card">
        <h3>Privacy‑First</h3>
        <p>Clear controls for visibility, membership, and data export. Respect for user choice by default.</p>
      </article>
    </div>
  </div>
</section>

<section id="events" class="section">
  <div class="container">
    <h2>Events & Meetups</h2>
    <div class="cards-grid">
      <article class="card">
        <h3>Simple Planning</h3>
        <p>Create events with dates, locations, and descriptions. Share in your group or publicly.</p>
      </article>
      <article class="card">
        <h3>RSVPs & Reminders</h3>
        <p>Manage attendance, send reminders, and share post‑event summaries and photos.</p>
      </article>
      <article class="card">
        <h3>Integrations</h3>
        <p>Connect calendars and share to social platforms. Export attendee lists securely.</p>
      </article>
      <article class="card">
        <h3>Community Highlights</h3>
        <p>Pin event recaps to threads and celebrate member contributions.</p>
      </article>
    </div>
  </div>
</section>

<section id="creators" class="section alt">
  <div class="container">
    <h2>Creator Tools & API</h2>
    <div class="cards-grid">
      <article class="card">
        <h3>Scheduling</h3>
        <p>Draft and schedule posts, pin threads, and manage announcements across groups.</p>
      </article>
      <article class="card">
        <h3>Analytics</h3>
        <p>See growth and engagement trends at a glance. Understand what content resonates.</p>
      </article>
      <article class="card">
        <h3>Open API</h3>
        <p>Build bots, sync data, and extend #community with a simple REST API.</p>
      </article>
    </div>
  </div>
</section>

<section class="section">
  <div class="container cta-band-inner">
    <h2>Ready to start your community?</h2>
    <p>Tell us about your group and get early access.</p>
    <%= link_to 'Request Access', contact_path, class: 'btn' %>
  </div>
</section>
