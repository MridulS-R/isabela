<% content_for :title, 'Solutions — VisionData' %>

<section class="section">
  <div class="container">
    <h1>Solutions</h1>
    <p class="lead">Organized for clarity: Data Solutions, Marketing Solutions, and APIs & Integrations.</p>
  </div>
  </section>

<section id="data-solutions" class="section alt">
  <div class="container">
    <h2>Data Solutions</h2>
    <div class="cards-grid">
      <article class="card">
        <h3>Comprehensive Datasets</h3>
        <p>Current business and consumer profiles with hundreds of attributes spanning firmographics, demographics, location, and digital signals.</p>
      </article>
      <article class="card">
        <h3>Data Enrichment & Cleansing</h3>
        <p>Fill gaps, correct inaccuracies, deduplicate entities, and standardize fields to unlock reliable analytics.</p>
      </article>
      <article class="card">
        <h3>Identity Resolution</h3>
        <p>Link business and consumer identities with deterministic and probabilistic methods to create blended personas.</p>
      </article>
      <article class="card">
        <h3>Compliance & Privacy</h3>
        <p>Processes aligned with GDPR and Indian IT laws. Consent, opt-outs, and data subject request workflows are built in.</p>
      </article>
    </div>
  </div>
</section>

<section id="marketing-solutions" class="section">
  <div class="container">
    <h2>Marketing Solutions</h2>
    <div class="cards-grid">
      <article class="card">
        <h3>Audience Segmentation</h3>
        <p>Create high-intent audiences by geography, industry, role, company size, spend signals, and more.</p>
      </article>
      <article class="card">
        <h3>Lead Generation & Acquisition</h3>
        <p>Acquire qualified B2B and B2C leads with transparent targeting, scoring, and performance reporting.</p>
      </article>
      <article class="card">
        <h3>Omnichannel Campaigns</h3>
        <p>Deliver personalized messaging across email, direct mail, and digital with creative support and deliverability best practices.</p>
      </article>
      <article class="card">
        <h3>Attribution & Lift</h3>
        <p>Measure campaign impact with holdouts, matchback, and multi-touch attribution to optimize ROI.</p>
      </article>
    </div>
  </div>
</section>

<section id="apis" class="section alt">
  <div class="container">
    <h2>APIs & Integrations</h2>
    <div class="cards-grid">
      <article class="card">
        <h3>Data API</h3>
        <p>Programmatic search and retrieval with filters, pagination, and attribute selection. JSON and CSV exports supported.</p>
      </article>
      <article class="card">
        <h3>Enrichment API</h3>
        <p>Append attributes in real time using keys like domain, email, phone, or company identifiers.</p>
      </article>
      <article class="card">
        <h3>CRM & MAP Integrations</h3>
        <p>Connect to popular CRMs and marketing automation platforms for streamlined activation and reporting.</p>
      </article>
    </div>
  </div>
</section>

<section class="section">
  <div class="container cta-band-inner">
    <h2>Ready to build your audience?</h2>
    <p>Tell us your goals and we’ll map the fastest path from data to outcomes.</p>
    <%= link_to 'Talk to a Data Expert', contact_path, class: 'btn' %>
  </div>
</section>

