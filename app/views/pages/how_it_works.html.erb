<% content_for :title, 'How It Works & Use Cases — #CommunNity' %>

<section class="section">
  <div class="container">
    <h1>How It Works</h1>
    <p class="lead">From onboarding to thriving conversations in four steps.</p>
    <div class="cards-grid">
      <article class="card">
        <h3>1) Join</h3>
        <p>Create your profile and follow interests that matter to you.</p>
      </article>
      <article class="card">
        <h3>2) Create</h3>
        <p>Start a group or join existing ones. Set visibility and guidelines in minutes.</p>
      </article>
      <article class="card">
        <h3>3) Share</h3>
        <p>Post updates, links, and events. Organize discussions into threads and keep topics on track.</p>
      </article>
      <article class="card">
        <h3>4) Grow</h3>
        <p>Invite members, empower moderators, and use analytics to understand what resonates.</p>
      </article>
    </div>
  </div>
  </section>

<section class="section alt">
  <div class="container">
    <h2>Use Cases</h2>
    <div class="cards-grid">
      <article class="card">
        <h3>Student Communities</h3>
        <p>Run clubs and interest groups with threads and events. Keep everyone in the loop.</p>
      </article>
      <article class="card">
        <h3>Open Source Projects</h3>
        <p>Share updates, organize contributor meetups, and highlight releases in a friendly space.</p>
      </article>
      <article class="card">
        <h3>Local Neighborhoods</h3>
        <p>Connect with neighbors, share resources, and plan community events.</p>
      </article>
      <article class="card">
        <h3>Events & Meetups</h3>
        <p>Host recurring events with RSVPs and share recaps for those who missed it.</p>
      </article>
    </div>
  </div>
</section>

<section class="section">
  <div class="container cta-band-inner">
    <h2>Want a tailored walkthrough?</h2>
    <p>Tell us about your community goals—we’ll craft a setup plan.</p>
    <%= link_to 'Request Access', contact_path(anchor: 'request-demo'), class: 'btn' %>
  </div>
</section>
