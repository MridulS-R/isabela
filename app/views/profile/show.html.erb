<% content_for :title, 'Profile' %>

<section class="section">
  <div class="container">
    <h1>Profile</h1>
    <p class="subtle">Manage your account.</p>
    <% if @sessions.present? %>
      <h2>Active sessions</h2>
      <table>
        <thead><tr><th>Device</th><th>IP</th><th>Last seen</th><th></th></tr></thead>
        <tbody>
          <% @sessions.each do |s| %>
            <tr>
              <td><%= s.user_agent.to_s.truncate(48) %> <% if @current_session_digest == s.token_digest %><span class="subtle">(This device)</span><% end %></td>
              <td><%= s.ip %></td>
              <td><%= time_ago_in_words(s.last_seen_at || s.updated_at) %> ago</td>
              <td></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <div style="display:flex; gap:8px; margin-top:8px">
        <%= button_to 'Sign out other sessions', sign_out_other_sessions_path, method: :post, class: 'btn btn-small', form: { data: { turbo_confirm: 'Sign out everywhere else?' } } %>
        <%= button_to 'Sign out all sessions', sign_out_all_sessions_path, method: :post, class: 'btn btn-small btn-outline', form: { data: { turbo_confirm: 'Sign out from all devices (including this one)?' } } %>
      </div>
    <% end %>

    <p><%= link_to 'Edit profile', edit_profile_path, class: 'link' %></p>

    <% if @is_admin %>
      <div class="cards-grid" style="margin-top:12px">
        <article class="card">
          <h3>Admin — Import</h3>
          <p class="subtle">Import Reddit posts, Instagram users, and News (select a community).</p>
          <%= link_to 'Open Import', new_import_path, class: 'btn btn-small' %>
        </article>
        <article class="card">
          <h3>Admin — Crawl News</h3>
          <p class="subtle">Crawl predefined news sources and ingest Articles for communities.</p>
          <form action="<%= url_for(controller: :news_crawl, action: :enqueue) %>" method="post" style="display:inline">
            <%= csrf_meta_tags %>
            <button class="btn btn-small" type="submit">Crawl all sources</button>
          </form>
          <p class="subtle" style="margin-top:8px"><%= link_to 'Manage sources', admin_news_sources_path, class: 'link' %></p>
        </article>
      </div>
    <% end %>
  </div>
</section>
