<% content_for :title, 'Search' %>

<section class="py-8">
  <div class="mx-auto max-w-5xl px-4">
    <h1 class="text-2xl font-bold">Search</h1>
    <%= form_with url: search_path, method: :get, local: true, class: 'mt-3 flex items-center gap-2' do %>
      <input type="text" name="q" value="<%= h(@q) %>" placeholder="Search posts, users, or tags" class="w-full px-3 py-2 rounded border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900">
      <select name="scope" class="px-3 py-2 rounded border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900">
        <option value="posts" <%= 'selected' if @scope == 'posts' %>>Posts</option>
        <option value="users" <%= 'selected' if @scope == 'users' %>>Users</option>
        <option value="tags" <%= 'selected' if @scope == 'tags' %>>Tags</option>
      </select>
      <button class="px-3 py-2 rounded-lg bg-slate-900 text-white hover:bg-black dark:bg-slate-800 dark:hover:bg-black">Search</button>
    <% end %>

    <% if @q.present? %>
      <% if @scope == 'users' %>
        <ul class="mt-4 space-y-2">
          <% (@users || []).each do |u| %>
            <li class="flex items-center justify-between rounded-lg border border-slate-200 dark:border-slate-800 p-2">
              <%= link_to (u.name.presence || u.email), user_public_path(u), class: 'text-sky-600 hover:underline' %>
              <% if user_signed_in? && current_user.id != u.id %>
                <% following = current_user.following.exists?(id: u.id) rescue false %>
                <% if following %>
                  <%= button_to 'Following', unfollow_user_path(u.id), method: :delete, class: 'px-2 py-1 rounded border border-slate-200 dark:border-slate-700' %>
                <% else %>
                  <%= button_to 'Follow', follow_user_path(u.id), method: :post, class: 'px-2 py-1 rounded bg-slate-900 text-white hover:bg-black dark:bg-slate-800 dark:hover:bg-black' %>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% elsif @scope == 'tags' %>
        <ul class="mt-4 space-y-2">
          <% (@tags || []).each do |t| %>
            <li class="flex items-center justify-between rounded-lg border border-slate-200 dark:border-slate-800 p-2">
              <%= link_to "##{t.name}", tag_path(t.name), class: 'text-sky-600 hover:underline' %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <ul class="mt-4 space-y-3">
          <% (@posts || []).each do |post| %>
            <li class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-3">
              <div class="text-sm text-slate-600 dark:text-slate-300">
                <span class="font-semibold text-slate-900 dark:text-slate-100"><%= post.user.name.presence || post.user.email %></span>
                <span>· <%= link_to "#{time_ago_in_words(post.created_at)} ago", post_path(post), class: 'text-sky-600 hover:underline' %></span>
              </div>
              <% if post.caption.present? %>
                <p class="mt-1"><%= post.caption %></p>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
  </div>
</section>

