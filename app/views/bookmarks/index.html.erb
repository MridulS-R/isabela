<% content_for :title, 'Bookmarks' %>

<section class="py-8">
  <div class="mx-auto max-w-6xl px-4">
    <h1 class="text-2xl font-bold mb-3">Bookmarks</h1>
    <% if @posts.any? %>
      <ul class="space-y-3">
        <% @posts.each do |post| %>
          <li class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-3">
            <div class="text-sm text-slate-600 dark:text-slate-300">
              <span class="font-semibold text-slate-900 dark:text-slate-100"><%= post.user.name.presence || 'User' %></span>
              <span>@<%= post.user.username.presence || post.user.email.to_s.split('@').first %></span>
              <span>· <%= link_to "#{time_ago_in_words(post.created_at)} ago", post_path(post), class: 'text-sky-600 hover:underline' %></span>
            </div>
            <% if post.caption.present? %>
              <p class="mt-1"><%= post.caption %></p>
            <% end %>
            <% if post.images.attached? %>
              <div class="mt-2 grid grid-cols-2 gap-2">
                <% post.images.each do |img| %>
                  <%= image_tag url_for(img), class: 'w-full h-auto rounded' %>
                <% end %>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-slate-500">No bookmarks yet.</p>
    <% end %>
  </div>
</section>

