<% content_for :title, 'Your Feed' %>

<section class="py-8">
  <div class="mx-auto max-w-6xl px-4 grid grid-cols-1 md:grid-cols-[1fr_320px] gap-4 items-start">
    <div>
      <div class="flex items-center justify-between mb-3">
        <h1 class="text-2xl font-bold">Your Feed</h1>
      </div>

      <div class="composer rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
        <%= form_with model: Post.new, url: posts_path, method: :post, multipart: true do |f| %>
          <%= f.text_area :caption, placeholder: "What's happening? #community_topic", required: false, class: 'w-full min-h-[64px] resize-y p-2 outline-none bg-transparent' %>
          <div class="row mt-2">
            <div class="inline-flex items-center gap-2">
              <label class="inline-flex items-center gap-2 px-2 py-1 rounded border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <path d="M21 15l-5-5L5 21"/>
                </svg>
                <%= f.file_field :images, multiple: true, accept: 'image/*', class: 'hidden' %>
                <span class="text-sm">Add images</span>
              </label>
              <%= text_field_tag 'post[community_slug]', nil, placeholder: 'community (e.g., dev)', required: true, class: 'px-3 py-2 rounded border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 text-sm' %>
            </div>
            <div>
              <%= f.submit 'Post', class: 'px-3 py-2 rounded-lg bg-slate-900 text-white hover:bg-black dark:bg-slate-800 dark:hover:bg-black text-sm' %>
            </div>
          </div>
        <% end %>
      </div>

      <div class="timeline space-y-3 mt-3">
        <% @posts.each do |post| %>
          <div class="tweet fade-in rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-3" data-url="<%= post_path(post) %>">
            <div>
              <% if post.user&.avatar&.attached? %>
                <%= image_tag url_for(post.user.avatar), alt: '', class: 'avatar rounded-full w-10 h-10 object-cover', loading: 'lazy' %>
              <% else %>
                <span class="avatar inline-block bg-slate-200 dark:bg-slate-700 w-10 h-10 rounded-full">&nbsp;</span>
              <% end %>
            </div>
            <div>
              <div class="tweet-header text-sm text-slate-600 dark:text-slate-300 flex items-center gap-2 flex-wrap">
                <span class="tweet-name font-semibold text-slate-900 dark:text-slate-100"><%= post.user.name.presence || 'User' %></span>
                <span class="tweet-handle">@<%= post.user.username.presence || post.user.email.to_s.split('@').first %></span>
                <span class="tweet-time">· <%= link_to "#{time_ago_in_words(post.created_at)} ago", post_path(post), class: 'link text-sky-600 hover:underline' %></span>
                <% if user_signed_in? && current_user.id != post.user_id %>
                  <% following = current_user.following.exists?(id: post.user_id) rescue false %>
                  <% if following %>
                    <%= button_to 'Following', unfollow_user_path(post.user_id), method: :delete, class: 'ml-2 px-2 py-1 rounded border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800' %>
                  <% else %>
                    <%= button_to 'Follow', follow_user_path(post.user_id), method: :post, class: 'ml-2 px-2 py-1 rounded bg-slate-900 text-white hover:bg-black dark:bg-slate-800 dark:hover:bg-black' %>
                  <% end %>
                <% end %>
              </div>
              <% if post.caption.present? %>
                <div class="tweet-body mt-1"><%= raw post.caption.gsub(/#(\w+)/){|m| link_to m, tag_path(m.delete('#').downcase), class: 'text-sky-600 hover:underline' } %></div>
              <% end %>
              <% if post.images.attached? %>
                <div class="tweet-media mt-2 grid grid-cols-2 gap-2">
                  <% post.images.each do |img| %>
                    <% next unless attachment_present?(img) %>
                    <%= image_tag url_for(img), alt: '', loading: 'lazy', class: 'w-full h-auto rounded' %>
                  <% end %>
                </div>
              <% end %>
              <div class="tweet-actions mt-2 flex items-center gap-2 text-sm">
                <%= button_to like_post_path(post), method: :post, class: 'inline-flex items-center gap-1 px-2 py-1 rounded border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800', form: { style: 'display:inline' } do %>
                  <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z" />
                  </svg>
                  <span class="count"><%= post.likes_count %></span>
                <% end %>
                <%= form_with url: post_comments_path(post), method: :post, local: true do |f| %>
                  <div class="inline-flex items-center gap-2">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M21 15a4 4 0 0 1-4 4H8l-5 5V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v8z" />
                    </svg>
                    <input type="text" name="body" placeholder="Reply" class="w-56 px-2 py-1 rounded border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900">
                  </div>
                <% end %>
                <%= button_to repost_post_path(post), method: :post, class: 'inline-flex items-center gap-1 px-2 py-1 rounded border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800' do %>
                  Repost
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <div class="flex gap-2 justify-center mt-3">
        <% if @page.to_i > 1 %>
          <%= link_to 'Previous', home_path(page: @page - 1, per: @per), class: 'px-3 py-2 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-sm' %>
        <% end %>
        <% if @has_more %>
          <%= link_to 'Load more', home_path(page: @page + 1, per: @per), class: 'px-3 py-2 rounded-lg bg-slate-900 text-white hover:bg-black dark:bg-slate-800 dark:hover:bg-black text-sm' %>
        <% end %>
      </div>
    </div>

    <aside>
      <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-3">
        <h3 class="font-semibold">Tips</h3>
        <p class="text-sm text-slate-600 dark:text-slate-300">Follow users and communities to build your feed.</p>
      </div>
    </aside>
  </div>
</section>
