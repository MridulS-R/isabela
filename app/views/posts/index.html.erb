<section class="section">
  <div class="container" style="display:grid; grid-template-columns: 1fr 320px; gap: 16px; align-items:start;">
    <div>
      <div class="header-inner" style="margin-bottom:12px">
        <h1>Posts</h1>
        <% if user_signed_in? %>
          <%= link_to 'New Post', new_post_path, class: 'btn btn-small' %>
        <% end %>
      </div>

      <% if user_signed_in? %>
        <div class="composer">
          <%= form_with model: Post.new, url: posts_path, method: :post, multipart: true do |f| %>
            <%= f.text_area :caption, placeholder: "What's happening? #community", required: false %>
            <div class="row">
              <div>
                <label class="icon-btn">
                  <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <path d="M21 15l-5-5L5 21"/>
                  </svg>
                  <%= f.file_field :images, multiple: true, accept: 'image/*', style: 'display:none' %>
                  <span>Add images</span>
                </label>
              </div>
              <div>
                <%= f.submit 'Post', class: 'btn btn-small' %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="timeline">
        <% @posts.each do |post| %>
          <div class="tweet fade-in">
            <div>
              <% if post.user&.avatar&.attached? %>
                <%= image_tag url_for(post.user.avatar), alt: '', class: 'avatar', loading: 'lazy' %>
              <% else %>
                <span class="avatar" style="display:inline-block; background:#e5e7eb;">&nbsp;</span>
              <% end %>
            </div>
            <div>
              <div class="tweet-header">
                <span class="tweet-name"><%= post.user.name.presence || 'User' %></span>
                <span class="tweet-handle">@<%= post.user.username.presence || post.user.email.to_s.split('@').first %></span>
                <span class="tweet-time">· <%= time_ago_in_words(post.created_at) %> ago</span>
              </div>
              <% if post.caption.present? %>
                <div class="tweet-body"><%= raw post.caption.gsub(/#(\w+)/){|m| link_to m, tag_path(m.delete('#').downcase) } %></div>
              <% end %>
              <% if post.images.attached? %>
                <div class="tweet-media">
                  <% post.images.each do |img| %>
                    <%= image_tag url_for(img), alt: '', loading: 'lazy' %>
                  <% end %>
                </div>
              <% end %>
              <div class="tweet-actions">
                <% if user_signed_in? %>
                  <%= button_to like_post_path(post), method: :post, class: 'icon-btn', form: { style: 'display:inline' } do %>
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z" />
                    </svg>
                    <span class="count"><%= post.likes_count %></span>
                  <% end %>
                  <%= form_with url: post_comments_path(post), method: :post, local: true do |f| %>
                    <div style="display:inline-flex; align-items:center; gap:6px">
                      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 15a4 4 0 0 1-4 4H8l-5 5V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v8z" />
                      </svg>
                      <input type="text" name="body" placeholder="Reply" style="width: 220px">
                    </div>
                  <% end %>
                <% else %>
                  <span class="count">❤️ <%= post.likes_count %></span>
                <% end %>
                <button type="button" class="icon-btn" title="Share">
                  <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7" />
                    <path d="M16 6l-4-4-4 4" />
                    <path d="M12 2v14" />
                  </svg>
                </button>
                <button type="button" class="icon-btn" title="Save">
                  <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <div style="display:flex; gap:8px; justify-content:center; margin-top:12px">
        <% if @page.to_i > 1 %>
          <%= link_to 'Previous', posts_path(page: @page - 1, per: @per, sort: params[:sort]), class: 'btn btn-small' %>
        <% end %>
        <% if @has_more %>
          <%= link_to 'Load more', posts_path(page: @page + 1, per: @per, sort: params[:sort]), class: 'btn btn-small' %>
        <% end %>
      </div>
    </div>

    <aside>
      <% if @trending_tags.present? %>
        <h2 class="footer-title">Trending</h2>
        <ul class="pill-list" role="list" style="margin-bottom:24px">
          <% @trending_tags.each do |t| %>
            <li><%= link_to "##{t.name}", tag_path(t.name) %></li>
          <% end %>
        </ul>
      <% end %>
      <div class="card">
        <h3>Tips</h3>
        <p class="subtle">Use hashtags to categorize posts, e.g., #design, #news</p>
      </div>
    </aside>
  </div>
</section>
