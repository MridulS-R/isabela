<section class="py-8">
  <div class="mx-auto max-w-6xl px-4 grid grid-cols-1 md:grid-cols-[1fr_320px] gap-4 items-start">
    <div class="surface p-4 sm:p-6">
      <div class="flex items-center justify-between mb-3">
        <h1 class="text-2xl font-bold">Thread</h1>
        <%= link_to 'Back to Posts', posts_path, class: 'text-sky-600 hover:underline' %>
      </div>
      <div class="brand-divider mb-4"></div>

      <div class="timeline">
        <!-- Main post -->
        <div class="tweet fade-in rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-3">
          <div>
            <% if @post.user&.avatar&.attached? %>
              <%= image_tag url_for(@post.user.avatar), alt: '', class: 'avatar', loading: 'lazy' %>
            <% else %>
              <span class="avatar inline-block bg-slate-200 dark:bg-slate-700 w-10 h-10 rounded-full">&nbsp;</span>
            <% end %>
          </div>
          <div>
            <div class="tweet-header flex items-center gap-2 flex-wrap">
              <span class="tweet-name"><%= @post.user.name.presence || 'User' %></span>
              <span class="tweet-handle">@<%= @post.user.username.presence || @post.user.email.to_s.split('@').first %></span>
              <span class="tweet-time">· <%= @post.created_at.strftime('%b %d, %Y %H:%M') %></span>
              <% if user_signed_in? && current_user.id != @post.user_id %>
                <% following = current_user.following.exists?(id: @post.user_id) rescue false %>
                <% if following %>
                  <%= button_to 'Following', unfollow_user_path(@post.user_id), method: :delete, class: 'ml-2 px-2 py-1 rounded border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800' %>
                <% else %>
                  <%= button_to 'Follow', follow_user_path(@post.user_id), method: :post, class: 'ml-2 px-2 py-1 rounded bg-slate-900 text-white hover:bg-black dark:bg-slate-800 dark:hover:bg-black' %>
                <% end %>
              <% end %>
            </div>
            <% if @post.caption.present? %>
              <div class="tweet-body"><%= raw @post.caption.gsub(/#(\w+)/){|m| link_to m, tag_path(m.delete('#').downcase) } %></div>
            <% end %>
            <% if @post.images.attached? %>
              <div class="tweet-media">
                <% @post.images.each do |img| %>
                  <% next unless attachment_present?(img) %>
                  <%= image_tag url_for(img), alt: '', loading: 'lazy' %>
                <% end %>
              </div>
            <% end %>
            <div class="tweet-actions mt-2 flex items-center gap-2 text-sm">
              <% if user_signed_in? %>
                <%= button_to like_post_path(@post), method: :post, class: 'btn btn-ghost text-sm', form: { style: 'display:inline' } do %>
                  <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z" />
                  </svg>
                  <span class="count"><%= @post.likes_count %></span>
                <% end %>
                <% saved = current_user&.bookmarked_posts&.exists?(id: @post.id) rescue false %>
                <% if saved %>
                  <%= button_to unbookmark_post_path(@post), method: :delete, class: 'btn btn-ghost text-sm' do %>
                    Unsave
                  <% end %>
                <% else %>
                  <%= button_to bookmark_post_path(@post), method: :post, class: 'btn btn-ghost text-sm' do %>
                    Save
                  <% end %>
                <% end %>
                <% if ENV['TIPS_URL'].present? %>
                  <%= link_to 'Tip', "#{ENV['TIPS_URL']}?user=#{@post.user_id}&post=#{@post.id}", class: 'btn btn-ghost text-sm' %>
                <% end %>
                <%= link_to 'Report', new_report_path(type: 'post', id: @post.id), class: 'px-2 py-1 rounded border border-slate-200 dark:border-slate-700' %>
              <% else %>
                <span class="count">❤️ <%= @post.likes_count %></span>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Reply form -->
        <% if user_signed_in? %>
          <div class="tweet fade-in rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-3">
            <div>
              <% if current_user&.avatar&.attached? %>
                <%= image_tag url_for(current_user.avatar), alt: '', class: 'avatar', loading: 'lazy' %>
              <% else %>
                <span class="avatar" style="display:inline-block; background:#e5e7eb;">&nbsp;</span>
              <% end %>
            </div>
            <div>
              <%= form_with url: post_comments_path(@post), method: :post, local: true do |f| %>
                <input type="text" name="body" placeholder="Reply to this post" class="w-full px-2 py-2 rounded border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900">
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Replies -->
        <% @comments.each do |c| %>
          <div class="tweet fade-in rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-3">
            <div>
              <% if c.user&.avatar&.attached? %>
                <%= image_tag url_for(c.user.avatar), alt: '', class: 'avatar', loading: 'lazy' %>
              <% else %>
                <span class="avatar inline-block bg-slate-200 dark:bg-slate-700 w-10 h-10 rounded-full">&nbsp;</span>
              <% end %>
            </div>
            <div>
              <div class="tweet-header">
                <span class="tweet-name"><%= c.user.name.presence || 'User' %></span>
                <span class="tweet-handle">@<%= c.user.username.presence || c.user.email.to_s.split('@').first %></span>
                <span class="tweet-time">· <%= time_ago_in_words(c.created_at) %> ago</span>
              </div>
              <div class="tweet-body mt-1"><%= sanitize c.body, tags: %w[b strong i em a], attributes: %w[href title] %></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <aside class="card p-3">
      <% if @related_posts.present? %>
        <h2 class="font-semibold mb-2">Related posts</h2>
        <ul class="space-y-2">
          <% @related_posts.each do |p| %>
            <li>
              <strong><%= link_to truncate(p.caption.to_s, length: 80), post_path(p), class: 'link-brand' %></strong>
              <div class="text-xs text-slate-500"><%= time_ago_in_words(p.created_at) %> ago • ❤️ <%= p.likes_count %></div>
            </li>
          <% end %>
        </ul>
      <% end %>
    </aside>
  </div>
</section>
