<section class="section">
  <div class="container" style="max-width:560px">
    <h1>Create your account</h1>
    <p class="subtle">Join #community and start your group.</p>

    <%= form_with model: @user, url: signup_path, local: true do |f| %>
      <% if @user.errors.any? %>
        <div class="error" role="alert">
          <strong>There were problems with your submission:</strong>
          <ul>
            <% @user.errors.full_messages.each do |m| %>
              <li><%= m %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-row">
        <div>
          <%= f.label :name, 'Name' %>
          <%= f.text_field :name, placeholder: 'Your name' %>
        </div>
        <div>
          <%= f.label :email, 'Email' %>
          <%= f.email_field :email, placeholder: 'you@example.com', required: true %>
        </div>
      </div>
      <div class="form-row">
        <div>
          <%= f.label :password, 'Password' %>
          <%= f.password_field :password, placeholder: 'At least 8 characters', required: true %>
        </div>
        <div>
          <%= f.label :password_confirmation, 'Confirm password' %>
          <%= f.password_field :password_confirmation, placeholder: 'Repeat password', required: true %>
        </div>
      </div>

      <%= f.submit 'Create account', class: 'btn' %>
      <p class="help">Already have an account? <%= link_to 'Log in', login_path %></p>
    <% end %>
  </div>
</section>

