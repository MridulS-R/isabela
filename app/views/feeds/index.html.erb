<% content_for :title, 'Manage News Feeds' %>

<section class="section">
  <div class="container">
    <h1>News Feeds</h1>
    <p class="subtle">Add RSS/Atom feeds to keep the News page fresh. New items appear automatically after refresh.</p>

    <%= form_with model: @feed, url: admin_feeds_path, method: :post do |f| %>
      <div class="form-row">
        <div style="flex:2">
          <%= f.label :url, 'Feed URL' %>
          <%= f.url_field :url, required: true, placeholder: 'https://example.com/feed.xml' %>
        </div>
        <div>
          <%= f.label :active, 'Active' %><br>
          <%= f.check_box :active, checked: true %>
        </div>
      </div>
      <%= f.submit 'Add Feed', class: 'btn' %>
    <% end %>
  </div>
</section>

<section class="section alt">
  <div class="container">
    <div class="header-inner" style="padding:0">
      <h2 style="margin:0">Configured feeds</h2>
      <%= button_to 'Refresh all', refresh_all_admin_feeds_path, method: :post, class: 'btn btn-small' %>
    </div>
    <table>
      <thead>
        <tr>
          <th>Title</th>
          <th>URL</th>
          <th>Active</th>
          <th>Last fetched</th>
          <th>Error</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @feeds.each do |feed| %>
          <tr>
            <td><%= feed.title.presence || '—' %></td>
            <td><%= link_to feed.url, feed.url, target: '_blank', rel: 'noopener' %></td>
            <td><%= feed.active ? 'Yes' : 'No' %></td>
            <td><%= feed.last_fetched_at&.strftime('%Y-%m-%d %H:%M') || '—' %></td>
            <td class="subtle"><%= truncate(feed.last_error.to_s, length: 60) %></td>
            <td>
              <%= button_to 'Refresh', refresh_admin_feed_path(feed), method: :post, class: 'btn btn-small' %>
              <%= button_to 'Remove', admin_feed_path(feed), method: :delete, class: 'btn btn-small btn-outline', form: { data: { turbo_confirm: 'Remove this feed?' } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

